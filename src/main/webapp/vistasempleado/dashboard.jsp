<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Portal empleado | Datebayo</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/styles/empleado.css"></head><body><div class="layout"><aside class="sidebar" id="sidebar"><a class="brand" href="${pageContext.request.contextPath}/empleado/dashboard">DATEBAYO EMPLEADO</a><nav class="navlinks"><a href="${pageContext.request.contextPath}/empleado/dashboard" class="NAVD active"><i class="fa-solid fa-gauge-high"></i> Dashboard</a><a href="${pageContext.request.contextPath}/empleado/pedidos" class="NAVP"><i class="fa-solid fa-bag-shopping"></i> Mis pedidos</a><a href="${pageContext.request.contextPath}/empleado/perfil" class="NAVF"><i class="fa-solid fa-user"></i> Mi perfil</a></nav><a class="logout" href="${pageContext.request.contextPath}/auth?action=logout"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a></aside><main class="main"><div class="topbar"><button class="menu-btn" id="menuBtn" type="button" aria-label="Abrir menú"><i class="fa-solid fa-bars"></i></button><h1>Panel de empleado</h1><span class="muted"><c:out value="${sessionScope.usuarioLogueado.nameUser}"/></span></div><c:if test="${not empty sessionScope.mensajeExito}"><div class="alert"><c:out value="${sessionScope.mensajeExito}"/></div><c:remove var="mensajeExito" scope="session"/></c:if><c:if test="${not empty sessionScope.errorMsg}"><div class="alert error"><c:out value="${sessionScope.errorMsg}"/></div><c:remove var="errorMsg" scope="session"/></c:if><section class="cards"><article class="card"><div class="muted">Usuario</div><div class="value" style="font-size:1.15rem"><c:out value="${sessionScope.usuarioLogueado.nameUser}"/></div></article><article class="card"><div class="muted">Pedidos asignados</div><div class="value"><c:out value="${empty pedidos ? 0 : pedidos.size()}"/></div></article><article class="card"><div class="muted">Acceso rápido</div><p style="margin-top:12px"><a class="btn btn-warning" href="${pageContext.request.contextPath}/empleado/pedidos">Consultar pedidos</a></p></article></section><section class="card"><h2 class="h5">Bienvenido al panel de trabajo</h2><p class="muted mb-0">Desde aquí puedes revisar los pedidos asociados a tu cuenta. Las acciones de validación de pagos requieren que el ID de empleado esté correctamente vinculado al usuario en la base de datos.</p></section></main></div><script src="${pageContext.request.contextPath}/javascript/empleado.js" defer></script></body></html>