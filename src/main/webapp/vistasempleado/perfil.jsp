<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Portal empleado | Datebayo</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/styles/empleado.css"></head><body><div class="layout"><aside class="sidebar" id="sidebar"><a class="brand" href="${pageContext.request.contextPath}/empleado/dashboard">DATEBAYO EMPLEADO</a><nav class="navlinks"><a href="${pageContext.request.contextPath}/empleado/dashboard" class="NAVD"><i class="fa-solid fa-gauge-high"></i> Dashboard</a><a href="${pageContext.request.contextPath}/empleado/pedidos" class="NAVP"><i class="fa-solid fa-bag-shopping"></i> Mis pedidos</a><a href="${pageContext.request.contextPath}/empleado/perfil" class="NAVF active"><i class="fa-solid fa-user"></i> Mi perfil</a></nav><a class="logout" href="${pageContext.request.contextPath}/auth?action=logout"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a></aside><main class="main"><div class="topbar"><button class="menu-btn" id="menuBtn" type="button" aria-label="Abrir menú"><i class="fa-solid fa-bars"></i></button><h1>Mi perfil</h1><span class="muted"><c:out value="${sessionScope.usuarioLogueado.nameUser}"/></span></div><c:if test="${not empty sessionScope.mensajeExito}"><div class="alert"><c:out value="${sessionScope.mensajeExito}"/></div><c:remove var="mensajeExito" scope="session"/></c:if><c:if test="${not empty sessionScope.errorMsg}"><div class="alert error"><c:out value="${sessionScope.errorMsg}"/></div><c:remove var="errorMsg" scope="session"/></c:if><section class="card"><div class="profile-row"><strong>Nombre</strong><span><c:out value="${sessionScope.usuarioLogueado.nameUser}"/></span></div><div class="profile-row"><strong>Correo</strong><span><c:out value="${sessionScope.usuarioLogueado.emailUser}"/></span></div><div class="profile-row"><strong>Roles</strong><span><c:forEach var="rol" items="${sessionScope.usuarioLogueado.rolesUser}"><span class="badge"><c:out value="${rol}"/></span> </c:forEach></span></div><p class="muted mt-3 mb-0">Para cambiar tus datos personales, contacta con el administrador de tu cuenta.</p></section></main></div><script src="${pageContext.request.contextPath}/javascript/empleado.js" defer></script></body></html>